    "preversion": "pnpm lint",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "bezier-easing": "^2.1.0",
    "color-string": "^1.9.1"
  },
  "devDependencies": {
