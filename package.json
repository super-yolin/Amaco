{
  "name": "amaco",
  "description": "CSS animation by JS — TypeScript-first, zero dependency on RAF polyfills",
  "version": "0.2.0",
  "author": "Whisker",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super-yolin/Amaco.git"
  },
  "bugs": {
    "url": "https://github.com/super-yolin/Amaco/issues"
  },
  "homepage": "https://github.com/super-yolin/Amaco#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@11.0.5",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
